# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Secrets ──────────────────────────────────────────────────────────────────
# `.env*` already covers .env, .env.local, .env.production and friends. The
# entries below cover the shapes that slipped past it or that tooling creates.
#
# This is a safety net, not the control. A credential in a tracked SOURCE file
# is not caught by any ignore rule — see scripts/uat-env.mjs for why the UAT
# scripts read theirs from the environment instead.
.env*
!.env.example
!*.env.example
*.key
*.p12
*.pfx
*.keystore
secrets.json
.supabase/
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated demo/screenshot artifacts
screenshots/
scripts/.demo-task-ids.json
supabase/.temp
supabase/.temp/**