# Copy to .env.local and fill in real values. .env.local is git-ignored.
# Every value below is a PLACEHOLDER — never commit a real URL or key.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Image Editor (fal.ai) ───────────────────────────────────────────────────
# Server-side only. Read by /api/image-editor/studio, which sends the uploaded
# photograph to fal-ai/bria/product-shot and returns the generated studio image.
# Never exposed to the browser — it has no NEXT_PUBLIC_ prefix, and the route
# returns the image, never the key.
#
# Get one from https://fal.ai/dashboard/keys. Every request is billable: the
# route asks for exactly one result per press of Generate and never retries.
FAL_KEY=

# ─── Scheduled cleanup (Vercel Cron) ─────────────────────────────────────────
# Shared secret for GET /api/image-editor/cleanup, the daily sweep that deletes
# Image Editor results more than seven days old which nobody marked Keep.
#
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET` on
# every cron invocation once the variable is set in the project's environment;
# the schedule itself lives in vercel.json. Set it in Vercel, not only here.
#
# With this UNSET the route answers 503 and deletes nothing — an unconfigured
# deployment must never expose an unauthenticated endpoint that removes rows.
# No user-facing route depends on it: expiry is enforced when results are READ,
# so a missing secret costs storage, never privacy.
CRON_SECRET=

# ─── SEO results (scheduled sessions) ────────────────────────────────────────
# Shared secret for POST /api/integrations/seo/ingest, the door the scheduled
# sessions on the owner's PC use to send their results. Set it in Vercel. With
# this UNSET the route answers 503 and writes nothing.
SEO_INGEST_SECRET=

# ─── Meta Ads (Marketing) ────────────────────────────────────────────────────
# META_ACCESS_TOKEN is a VIEW-ONLY token from a system user (Employee role, View
# performance on the ad account) in the owner's Meta business. Set it in Vercel
# and redeploy; never put a real value here, in git or in chat. It expires or is
# removed from time to time: the Marketing page then says so and keeps the last
# good numbers.
# META_AD_ACCOUNT_IDS is the ad account id(s), digits only, comma separated.
# With either UNSET, GET /api/integrations/meta/sync (daily, 06:10 IST) answers
# "not_configured" and reads nothing.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=

# ─── Sales: chats on the business WhatsApp number become leads ───────────────
# GET/POST /api/sales/capture/whatsapp. Receive only: nothing is ever sent.
# WA_VERIFY_TOKEN is any long random string you make up; paste the same string in the
# Meta app dashboard (WhatsApp > Configuration > Verify token) when you save the
# callback address. META_APP_SECRET is the app's secret (Meta app > Settings > Basic);
# every delivery is checked against it. Set both in Vercel (Production), never here,
# in git or in chat, and redeploy. With either UNSET the route answers 503.
#
# Is it a lead? (20270613000000) The same route sends a NEW number's words (never the
# number) to Claude with ANTHROPIC_API_KEY (below) to tell a buyer from a job seeker,
# supplier or transport company. With the key UNSET every new chat becomes a lead
# tagged Check: nothing is lost. WA_CLASSIFY_MODEL (optional) overrides the model.
#
# Connecting the company number (Control Center > WhatsApp Connection) opens Meta's
# Embedded Signup pop-up. Both values are PUBLIC (they reach the browser), not secrets:
# NEXT_PUBLIC_META_APP_ID is the Meta app's ID (Settings > Basic) and
# NEXT_PUBLIC_WA_SIGNUP_CONFIG_ID is the configuration ID from Facebook Login for
# Business > Configurations. Set both in Vercel and redeploy; UNSET = "Setup missing".
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WA_SIGNUP_CONFIG_ID=
WA_VERIFY_TOKEN=
META_APP_SECRET=
WA_CLASSIFY_MODEL=

# ─── UAT scripts (scripts/uat-*.mjs) ─────────────────────────────────────────
# These scripts create, modify and DELETE records in bulk using the
# service-role key. Point them at a local stack or a disposable UAT project.
#
# Password used for the generated [TEST-UAT] logins. Any value; it is never
# printed by the scripts.
UAT_USER_PASSWORD=choose-a-throwaway-password

# ─── Remote target authorization — NOT an env-file setting ───────────────────
# The UAT scripts refuse to run against ANY hosted Supabase project, production
# included, because they cannot tell one hosted project from another. A local
# target (localhost / 127.0.0.1 / ::1 / 0.0.0.0 / *.localhost) needs nothing.
#
# To authorize one hosted UAT project for ONE run, type the override on the
# command line. It names the project it authorizes: the reference is the first
# label of that project's hostname, so an override written for one project can
# never authorize another.
#
#   UAT_ALLOW_REMOTE_TARGET=I-KNOW-THIS-IS-NOT-PRODUCTION:your-uat-project-ref \
#     node scripts/uat-seed.mjs
#
# Deliberately NOT listed as a variable above: the guard reads this only from
# the shell, snapshotting it before dotenv loads anything. A value placed in
# .env, .env.local, .env.production or any other dotenv file is IGNORED. Do not
# store it in a file — standing authorization to write to a hosted project is
# exactly what this guard exists to prevent.

# ─── Exhibition Leads: scan a visiting card / visitor form (Anthropic) ───────
# Server-side only. Read by /api/exhibition-leads/scan, which sends ONE photograph
# per scan to Claude and gets the contact details back; the photograph is not
# stored. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
#
# With this UNSET the Scan buttons still show, tell the salesperson scanning is
# not switched on, and the lead is typed as before — capturing a lead never
# depends on it. Set it in Vercel as well as here.
# EXHIBITION_SCAN_MODEL overrides the default model if you want a cheaper one.
ANTHROPIC_API_KEY=
