# UAT script environment — EXAMPLE ONLY
#
# Copy to a file the repository ignores, fill in real values, and source it for
# the command you are running. Do NOT commit the filled-in copy.
#
#   cp scripts/uat.env.example .env.uat.local     # .env* is git-ignored
#
# Every variable is required by the script that uses it. There are no defaults:
# a silent fallback is how a script aimed at a scratch project quietly runs
# against production instead.
#
# ⚠️  UAT_SUPABASE_SERVICE_ROLE_KEY bypasses every row-level security policy.
#     Treat it like a database root password. Never commit it, never paste it
#     into a chat or an issue, and rotate it immediately if it is exposed.
#
# ⚠️  These scripts WRITE and DELETE data. Point them at a scratch project, not
#     at production, unless you specifically intend otherwise.

# Supabase project URL.
UAT_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — bypasses RLS. Supabase dashboard → Settings → API.
UAT_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Anon / publishable key — used to sign in as a seeded test user.
UAT_SUPABASE_ANON_KEY=replace-me

# Shared password for the seeded [TEST-UAT] accounts.
UAT_PASSWORD=replace-me

# Which script needs what:
#
#   scripts/uat-cleanup.mjs   URL, SERVICE_ROLE_KEY
#   scripts/uat-seed.mjs      URL, SERVICE_ROLE_KEY, PASSWORD
#   scripts/uat-simulate.mjs  URL, SERVICE_ROLE_KEY, ANON_KEY, PASSWORD
