{
  "name": "boe-task-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm run docs:check && npm run typecheck && npm run lint:baseline && npm test && npm run build",
    "lint:baseline": "node scripts/lint-baseline.mjs",
    "permissions:sync": "tsx scripts/sync-permissions.ts",
    "permissions:check": "tsx scripts/sync-permissions.ts --check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/pdfkit": "^0.17.6",
    "fflate": "^0.8.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pdfkit": "^0.19.1",
    "postcss": "^8.5.15",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
